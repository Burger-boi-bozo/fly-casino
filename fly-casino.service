[Unit]
Description=Fly Casino V3 Connectome-Inspired Organism
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/fly-casino
ExecStart=/usr/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:8080 --timeout 60 app:app
Restart=always
RestartSec=3
User=root
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
